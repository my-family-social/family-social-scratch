    "drizzle-orm": "^0.45.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "otplib": "^13.3.0",
    "pg": "^8.18.0",
