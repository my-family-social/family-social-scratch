    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "react-email": "^5.2.9",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
