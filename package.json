{
  "name": "family-social-scratch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "digest:worker": "tsx scripts/weekly-activity-digest-worker.ts",
    "dev": "node ./scripts/run-next-with-env.mjs --webpack",
    "dev:google-local": "node ./scripts/run-next-with-env.mjs .env.google-local --hostname 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ./local.my-family-social.com-key.pem --experimental-https-cert ./local.my-family-social.com.pem --webpack",
    "dev:google-local:turbopack": "node ./scripts/run-next-with-env.mjs .env.google-local --hostname 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ./local.my-family-social.com-key.pem --experimental-https-cert ./local.my-family-social.com.pem --turbopack",
    "dev:apple-local": "node ./scripts/run-next-with-env.mjs .env.apple-local --hostname 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ./local.my-family-social.com-key.pem --experimental-https-cert ./local.my-family-social.com.pem --webpack",
    "dev:https-local": "node ./scripts/run-next-with-env.mjs .env.google-local --hostname 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ./local.my-family-social.com-key.pem --experimental-https-cert ./local.my-family-social.com.pem --webpack",
    "build": "next build",
    "start": "next start",
    "start:google-local": "node ./scripts/run-next-with-env.mjs .env.google-local --start --hostname 0.0.0.0 --port 3000 --experimental-https --experimental-https-key ./local.my-family-social.com-key.pem --experimental-https-cert ./local.my-family-social.com.pem",
    "lint": "eslint .",
    "test:db-logging": "vitest run src/components/db/sql/db-error-logger.test.ts",
    "test:db-logging-debug": "vitest run src/components/db/sql/db-error-logger.debug.test.ts",
    "test:foodies-state": "vitest run src/features/foodies/tests/foodies-home-page.state.test.ts",
    "test:sentry-live": "vitest run src/app/global-error.sentry-live.test.ts",
    "test:threads": "vitest run --dir src/features/threads/tests",
    "test:threads-ui": "vitest run src/features/threads/tests/thread-conversation-detail-ui-regression.test.tsx",
    "seed:poem-terms": "node ./scripts/import-poem-terms.mjs",
    "seed:poem-categories": "node ./scripts/seed-poem-category-tags.mjs",
    "seed:book-besties": "node ./scripts/seed-book-besties.mjs",
    "seed:family-s3": "node ./scripts/seed-family-s3-credentials.mjs",
    "seed:video-s3": "node ./scripts/seed-video-s3-credentials.mjs"
  },
